# Public web variables: names only; never place secrets here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ORIGIN=

# Server-only variables: never expose through NEXT_PUBLIC_* or mobile configuration.
SUPABASE_SERVICE_ROLE_KEY=
APERTURE_OWNER_EMAIL=
APERTURE_OWNER_ID=
# Local development only. Production and preview builds reject this flag.
APERTURE_AUTH_DEV_BYPASS=false
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
APERTURE_STRAVA_MODE=disabled
APERTURE_WEB_ORIGIN=
DATABASE_URL=
# Enables authenticated, confirmed transactional recovery using DATABASE_URL.
APERTURE_RECOVERY_ENABLED=false
STRAVA_TOKEN_ENCRYPTION_KEY=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
# Explicit operator opt-in plus an owner-prepared snapshot are both required.
APERTURE_PORTFOLIO_PUBLIC=false
