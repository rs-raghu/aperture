# Public mobile variables: names only; never place server or integration secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_SCHEME=
EXPO_PUBLIC_APERTURE_OWNER_EMAIL=
EXPO_PUBLIC_APERTURE_OWNER_ID=
# Local development only. Non-development builds reject this flag.
EXPO_PUBLIC_APERTURE_AUTH_DEV_BYPASS=false

# SUPABASE_SERVICE_ROLE_KEY and integration credentials must never be mobile variables.
