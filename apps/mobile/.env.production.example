# Public bundle configuration; keys must be publishable, never privileged.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_SCHEME=aperture
EXPO_PUBLIC_APERTURE_OWNER_EMAIL=
EXPO_PUBLIC_APERTURE_OWNER_ID=
EXPO_PUBLIC_APERTURE_WEB_URL=
EXPO_PUBLIC_APERTURE_AUTH_DEV_BYPASS=false
# EAS build identifiers belong to the verified owner's project.
APERTURE_ANDROID_PACKAGE=
APERTURE_IOS_BUNDLE_IDENTIFIER=
APERTURE_EAS_PROJECT_ID=
