{
  "name": "@aperture/finance",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/runtime.ts",
      "import": "./dist/runtime.js"
    },
    "./contracts": {
      "types": "./src/index.d.ts"
    }
  },
  "scripts": {
    "generate": "node scripts/generate-schemas.mjs",
    "check:generated": "node scripts/generate-schemas.mjs --check",
    "typecheck": "npm run check:generated && tsc --project tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @aperture/validation && npm run build --workspace @aperture/finance",
    "test": "vitest run",
    "build": "npm run check:generated && tsc --project tsconfig.build.json",
    "lint": "npm run check:generated && tsc --project tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "@aperture/validation": "0.5.0",
    "decimal.js": "^10.6.0"
  }
}
