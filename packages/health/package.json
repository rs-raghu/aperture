{
  "name": "@aperture/health",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./src/contracts.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @aperture/validation && npm run build --workspace @aperture/health",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json",
    "lint": "tsc --project tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "@aperture/validation": "0.5.0"
  }
}
