{
  "name": "@aperture/education",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./src/models.ts",
      "import": "./dist/models.js"
    },
    "./calculations": {
      "types": "./src/calculations.ts",
      "import": "./dist/calculations.js"
    },
    "./application": {
      "types": "./src/application.ts",
      "import": "./dist/application.js"
    },
    "./contracts": {
      "types": "./src/contracts.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @aperture/validation && npm run build --workspace @aperture/education",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@aperture/validation": "0.5.0",
    "decimal.js": "^10.6.0"
  }
}
