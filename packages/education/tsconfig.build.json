{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/models.ts",
    "src/calculations.ts",
    "src/application.ts",
    "src/education.types.ts",
    "src/education.errors.ts",
    "src/**/*.types.ts",
    "src/calculations/**/*.ts",
    "src/application/**/*.ts",
    "src/services/education-service.ts",
    "src/services/education-service.types.ts",
    "src/services/summaries/**/*.ts",
    "src/repositories/**/*.ts",
    "src/**/*.repository.ts"
  ],
  "exclude": [
    "src/institutions/*.contracts.ts",
    "src/programs/*.contracts.ts",
    "src/semesters/*.contracts.ts",
    "src/courses/*.contracts.ts",
    "src/topics/*.contracts.ts",
    "src/assignments/*.contracts.ts",
    "src/exams/*.contracts.ts",
    "src/grades/*.contracts.ts",
    "src/attendance/*.contracts.ts",
    "src/study-sessions/*.contracts.ts",
    "src/schedules/*.contracts.ts",
    "src/resources/*.contracts.ts",
    "src/certificates/*.contracts.ts",
    "src/goals/*.contracts.ts",
    "src/services/education-service.contract.ts",
    "src/contracts.d.ts",
    "test/**/*",
    "dist/**/*"
  ]
}
