{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/models.ts",
    "src/education.types.ts",
    "src/education.errors.ts",
    "src/**/*.types.ts"
  ],
  "exclude": [
    "src/**/*.contracts.ts",
    "src/**/*.repository.ts",
    "src/repositories/**/*",
    "src/services/**/*",
    "src/contracts.d.ts",
    "test/**/*",
    "dist/**/*"
  ]
}
