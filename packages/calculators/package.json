{
  "name": "@aperture/calculators",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/runtime.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
