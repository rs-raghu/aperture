{
  "name": "@aperture/portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "import": "./dist/supabase.js"
    },
    "./backup": {
      "types": "./dist/backup.d.ts",
      "import": "./dist/backup.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "tsc --project tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run"
  },
  "dependencies": {
    "@aperture/validation": "^0.5.0",
    "@supabase/supabase-js": "^2.114.0",
    "@aperture/backup": "^0.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14"
  }
}
